# Rendered at container start by the nginx image's envsubst step (only
# variables that are actually set get substituted, so $host etc. survive).
# BACKEND_URL defaults to the docker-compose service name; the Helm chart
# points it at the backend Service.
server {
    listen 8080;

    location /api/ {
        proxy_pass ${BACKEND_URL};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location = /healthz {
        access_log off;
        return 200 "ok";
    }

    location / {
        root /usr/share/nginx/html;
        try_files $uri /index.html;
    }
}
